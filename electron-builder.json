{
  "appId": "com.classpethome.app",
  "productName": "班级宠物园",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.js",
    "electron/preload.js"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "班级宠物园-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "班级宠物园",
    "runAfterFinish": true,
    "language": "2052"
  }
}
